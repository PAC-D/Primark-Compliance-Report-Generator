<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 12px;
      line-height: 1.4;
      color: #1a1a1a;
      background: #e5e7eb;
    }

    @page {
      size: A4 portrait;
      margin: 0;
    }

    @page landscape {
      size: A4 landscape;
      margin: 0;
    }

.page {
      width: 210mm;
      min-height: 297mm;
      background: white;
      margin: 0 auto 5px auto;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .page-content {
      flex: 1;
      padding: 8px 14px;
      display: flex;
      flex-direction: column;
    }

    .page-landscape {
      width: 297mm;
      min-height: 210mm;
      background: white;
      margin: 0 auto 10px auto;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      /* Force landscape using rotate transform so PDF picks it up */
      size: A4 landscape;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 14px;
      border-bottom: 4px solid #4A90D9;
      background: white;
      flex-shrink: 0;
    }

    .page-header.red-accent {
      border-bottom-color: #4A90D9;
    }

.brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-img {
      height: 40px;
      width: auto;
      object-fit: contain;
    }

    .brand-img-primark {
      height: 25px;
      width: auto;
      object-fit: contain;
    }

    .brand-img-allport {
      height: 28px;
      width: auto;
      object-fit: contain;
    }

    .logo {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, #4A90D9 0%, #2C5F8A 100%);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 800;
      font-size: 16px;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
    }

    .brand-name {
      font-size: 16px;
      font-weight: 800;
      color: #4A90D9;
      letter-spacing: -0.5px;
      line-height: 1.1;
    }

    .brand-sub {
      font-size: 7px;
      font-weight: 600;
      color: #9ca3af;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .brand-name {
      font-size: 20px;
      font-weight: 800;
      color: #4A90D9;
      letter-spacing: -0.5px;
      line-height: 1.1;
    }

    .brand-sub {
      font-size: 8px;
      font-weight: 600;
      color: #9ca3af;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .badge {
      background: #4A90D9;
      color: white;
      font-size: 9px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .page-content {
      flex: 1;
      padding: 12px 18px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

.page-footer {
      display: flex;
      justify-content: space-between;
      padding: 6px 16px;
      border-top: 1px solid #e5e7eb;
      font-size: 8px;
      color: #6b7280;
      background: #f9fafb;
      flex-shrink: 0;
    }

    .section-label {
      font-size: 10px;
      font-weight: 700;
      color: #1B2838;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .report-title {
      font-size: 28px;
      font-weight: 800;
      color: #1B2838;
      letter-spacing: -1px;
      margin-top: 2px;
    }

    .report-period {
      font-size: 13px;
      color: #6b7280;
      margin-top: 2px;
    }

    .supplier-card {
      background: #1B2838;
      border-radius: 12px;
      padding: 18px 20px;
      color: white;
      text-align: center;
      margin: 14px 0;
    }

    .supplier-name {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .supplier-meta {
      font-size: 10px;
      opacity: 0.8;
      margin-top: 4px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* KPI Grid */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 14px;
    }

    .kpi-card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 12px;
      position: relative;
      overflow: hidden;
    }

    .kpi-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
    }

    .kpi-card.blue::before { background: #4A90D9; }
    .kpi-card.red::before { background: #e31837; }
    .kpi-card.green::before { background: #059669; }
    .kpi-card.orange::before { background: #ea580c; }

    .kpi-label {
      font-size: 8px;
      font-weight: 600;
      color: #9ca3af;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .kpi-value {
      font-size: 22px;
      font-weight: 800;
      color: #1f2937;
      line-height: 1.1;
      margin-top: 3px;
    }

    .kpi-value.blue { color: #1B2838; }
    .kpi-value.red { color: #e31837; }
    .kpi-value.green { color: #059669; }
    .kpi-value.orange { color: #ea580c; }

    .kpi-sub {
      font-size: 8px;
      color: #6b7280;
      margin-top: 2px;
    }

    /* Compliance Hero */
    .compliance-hero {
      background: #1B2838;
      border-radius: 14px;
      padding: 22px;
      color: white;
      text-align: center;
      margin-bottom: 14px;
    }

    .compliance-label {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      opacity: 0.85;
    }

    .compliance-value {
      font-size: 62px;
      font-weight: 800;
      line-height: 1;
      margin: 6px 0 10px;
    }

    .compliance-value sup {
      font-size: 28px;
      vertical-align: super;
    }

    .compliance-track {
      height: 10px;
      background: rgba(255,255,255,0.2);
      border-radius: 5px;
      overflow: hidden;
    }

    .compliance-track-fill {
      height: 100%;
      background: linear-gradient(90deg, #4A90D9, #7AB3E8);
      border-radius: 5px;
      transition: width 0.3s;
    }

    .compliance-meta {
      display: flex;
      justify-content: space-between;
      margin-top: 8px;
      font-size: 9px;
      opacity: 0.7;
    }

    /* Charts Row */
    .charts-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 10px;
    }

    .chart-card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 10px;
    }

    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .chart-title {
      font-size: 8px;
      font-weight: 700;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .chart-badge {
      font-size: 7px;
      font-weight: 600;
      background: #f3f4f6;
      color: #6b7280;
      padding: 2px 6px;
      border-radius: 3px;
    }

    /* Section Headers */
    .section-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }

    .section-title {
      font-size: 12px;
      font-weight: 700;
      color: #1B2838;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .section-line {
      flex: 1;
      height: 2px;
      background: #E5E7EB;
    }

    /* Tables */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
      margin-bottom: 6px;
    }

    thead {
      background: #1B2838;
      color: white;
    }

    th {
      font-weight: 600;
      text-transform: uppercase;
      font-size: 7px;
      letter-spacing: 0.3px;
      padding: 4px 6px;
      text-align: left;
    }

    th.text-right, td.text-right { text-align: right; }
    th.text-center, td.text-center { text-align: center; }

    td {
      padding: 3px 6px;
      border-bottom: 1px solid #e5e7eb;
      color: #374151;
    }

    tbody tr:nth-child(even) { background: #f9fafb; }
    tbody tr:hover { background: #f3f4f6; }

    th.sub-col-header {
      background: #1B2838;
      font-size: 7px;
      border-bottom: 1px solid #e5e7eb;
    }
    th.sub-col {
      background: #1B2838;
      font-size: 7px;
      font-weight: 600;
    }
    tr.total-row td {
      background: #f3f4f6;
      border-top: 2px solid #1B2838;
      font-weight: 600;
    }
    tr.total-row:hover { background: #f3f4f6; }

    .text-primary { color: #1B2838; font-weight: 600; }
    .text-success { color: #059669; font-weight: 600; }
    .text-danger { color: #dc2626; font-weight: 600; }
    .text-warning { color: #ea580c; font-weight: 600; }

    .status-badge {
      display: inline-block;
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 7px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .status-badge.success { background: #d1fae5; color: #059669; }
    .status-badge.danger { background: #fee2e2; color: #dc2626; }
    .status-badge.warning { background: #fef3c7; color: #ea580c; }

    /* Landscape Transaction Table Page */
    .landscape-page {
      background: white;
      display: flex;
      flex-direction: column;
    }

    .landscape-page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 16px;
      border-bottom: 5px solid #4A90D9;
    }

    .landscape-page-content {
      flex: 1;
      padding: 8px 14px;
      overflow: hidden;
    }

    .landscape-table {
      font-size: 6.5px;
      table-layout: fixed;
    }

    .landscape-table th,
    .landscape-table td {
      padding: 3px 4px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .landscape-table th.sl-col { width: 25px; }
    .landscape-table th.origin-col { width: 50px; }
    .landscape-table th.factory-col { width: 120px; }
    .landscape-table th.destpo-col { width: 60px; }
    .landscape-table th.kimball-col { width: 55px; }
    .landscape-table th.size-col { width: 35px; }
    .landscape-table th.poqty-col { width: 45px; }
    .landscape-table th.handover-col { width: 75px; }
    .landscape-table th.unitctn-col { width: 50px; }
    .landscape-table th.dimension-col { width: 90px; }
    .landscape-table th.supplier-col { width: 100px; }
    .landscape-table th.updated-col { width: 60px; }
    .landscape-table th.approved-col { width: 60px; }
    .landscape-table th.confirm-col { width: 65px; }
    .landscape-table th.compliance-col { width: 55px; }

    .landscape-table th {
      background: #1B2838;
      color: white;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 6px;
      letter-spacing: 0.2px;
      position: sticky;
      top: 0;
    }

    .landscape-table td {
      border-bottom: 1px solid #e5e7eb;
      color: #374151;
    }

    .landscape-table tbody tr:nth-child(even) { background: #f9fafb; }
    .landscape-table tbody tr:hover { background: #f3f4f6; }

    .landscape-footer {
      display: flex;
      justify-content: space-between;
      padding: 6px 16px;
      border-top: 1px solid #e5e7eb;
      font-size: 8px;
      color: #6b7280;
      background: #f9fafb;
    }

    /* Page breaks */
    .page-break {
      page-break-before: always;
    }

    /* Two column layout for factory summary */
    .summary-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .summary-section {
      display: flex;
      flex-direction: column;
    }

    /* Report Title Block */
    .report-title-block {
      text-align: center;
      margin-bottom: 4px;
      flex-shrink: 0;
    }
    .report-title-main {
      font-size: 22px;
      font-weight: 800;
      color: #1B2838;
      letter-spacing: -0.3px;
    }
    .report-title-sub {
      font-size: 14px;
      font-weight: 600;
      color: #6B7280;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 2px;
    }
    .report-period {
      font-size: 15px;
      color: #9ca3af;
      margin-top: 2px;
    }

    /* Supplier Header - Info Cards */
    .supplier-header {
      text-align: center;
      margin-bottom: 4px;
      flex-shrink: 0;
    }
    .supplier-name-large {
      font-size: 20px;
      font-weight: 800;
      color: #1B2838;
      margin-bottom: 10px;
      line-height: 1.2;
    }
    .info-cards {
      display: flex;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
      align-items: flex-start;
      margin-bottom: 8px;
    }
    .info-card {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      padding: 7px 12px;
      min-width: 100px;
      text-align: center;
    }
    .info-card-label {
      font-size: 8px;
      font-weight: 600;
      color: #9ca3af;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 2px;
    }
    .info-card-value {
      font-size: 15px;
      font-weight: 800;
      color: #1B2838;
      line-height: 1.1;
    }
    .info-cards-row2 {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      align-items: flex-start;
      padding-top: 6px;
      margin-top: 4px;
    }
    .shared-badge {
      font-size: 0.65em;
      color: #9ca3af;
      font-weight: 500;
    }

    /* Compliance Gauge */
    .gauge-section {
      display: flex;
      justify-content: center;
      margin-bottom: 8px;
      flex-shrink: 0;
    }
    .gauge-svg {
      width: 220px;
      height: 130px;
    }
    .gauge-text {
      font-size: 26px;
      font-weight: 800;
      fill: #4A90D9;
      font-family: Inter, sans-serif;
    }
    .gauge-label {
      font-size: 9px;
      fill: #6b7280;
      font-family: Inter, sans-serif;
      text-transform: uppercase;
    }

/* Charts: 2+1 Layout */
    .charts-row {
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex-shrink: 0;
    }
    .charts-top {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      height: 240px;
    }
    .charts-bottom {
    }
    .chart-box {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 10px;
      height: 240px;
    }
    .chart-box-title {
      font-size: 9px;
      font-weight: 700;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
      text-align: center;
    }
    .chart-box canvas {
      width: 100% !important;
      height: calc(100% - 24px) !important;
      image-rendering: -webkit-optimize-contrast !important;
      image-rendering: crisp-edges !important;
    }
    .charts-row.multi-country:not(.long-name) .charts-top,
    .charts-row.multi-country:not(.long-name) .charts-top .chart-box,
    .charts-row.multi-country:not(.long-name) .charts-bottom .chart-box {
      height: 220px;
    }
    .charts-row.long-name:not(.multi-country) .charts-top,
    .charts-row.long-name:not(.multi-country) .charts-top .chart-box,
    .charts-row.long-name:not(.multi-country) .charts-bottom .chart-box {
      height: 230px;
    }
    .charts-row.multi-country.long-name .charts-top,
    .charts-row.multi-country.long-name .charts-top .chart-box,
    .charts-row.multi-country.long-name .charts-bottom .chart-box {
      height: 210px;
    }
    .charts-top {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      height: 335px;
    }
    .charts-bottom {
    }
    .chart-box {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 12px;
      height: 335px;
    }
    .chart-box-title {
      font-size: 9px;
      font-weight: 700;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      text-align: center;
    }
    .chart-box canvas {
      width: 100% !important;
      height: calc(100% - 28px) !important;
      image-rendering: -webkit-optimize-contrast !important;
      image-rendering: crisp-edges !important;
    }
    .charts-row.multi-country:not(.long-name) .charts-top,
    .charts-row.multi-country:not(.long-name) .charts-top .chart-box,
    .charts-row.multi-country:not(.long-name) .charts-bottom .chart-box {
      height: 300px;
    }
    .charts-row.long-name:not(.multi-country) .charts-top,
    .charts-row.long-name:not(.multi-country) .charts-top .chart-box,
    .charts-row.long-name:not(.multi-country) .charts-bottom .chart-box {
      height: 320px;
    }
    .charts-row.multi-country.long-name .charts-top,
    .charts-row.multi-country.long-name .charts-top .chart-box,
    .charts-row.multi-country.long-name .charts-bottom .chart-box {
      height: 280px;
    }
  </style>
</head>
<body>

<!-- ==================== PORTRAIT PAGES ==================== -->

<!-- PAGE 1: Dashboard -->
<div class="page">
  <div class="page-header red-accent">
    <img class="brand-img-primark" src="{{ primark_logo }}" alt="Primark">
    <span style="display:none">PRIMARK</span>
    <img class="brand-img-allport" src="{{ allport_logo }}" alt="Allport Pacd">
  </div>

  <div class="page-content">
    <!-- Title -->
    <div class="report-title-block">
      <div class="report-title-main">Transit Packaging System (TPS)</div>
      <div class="report-title-sub">Compliance Report (Initial Lines only)</div>
      <div class="report-period">{{ month_name }} {{ year }}</div>
    </div>

    <!-- Supplier Header with Info Cards -->
    <div class="supplier-header">
      <div class="supplier-name-large">{{ supplier_name }}</div>
      <div class="info-cards">
        <div class="info-card">
          <div class="info-card-label">Origin Country</div>
          <div class="info-card-value">{{ kpis.origin_country }}</div>
        </div>
        <div class="info-card">
          <div class="info-card-label">No of Factories</div>
          <div class="info-card-value">{{ kpis.factory_count }}</div>
        </div>
        {% if not multi_country %}
        <div class="info-card">
          <div class="info-card-label">Global Ranking</div>
          <div class="info-card-value">#{{ ranking }} of {{ total_suppliers }}{% if shared %} <span class="shared-badge">(shared)</span>{% endif %}</div>
        </div>
        {% for lr in local_rankings %}
        <div class="info-card">
          <div class="info-card-label">Local Ranking ({{ lr.country }})</div>
          <div class="info-card-value">#{{ lr.rank }} of {{ lr.total }}{% if lr.shared %} <span class="shared-badge">(shared)</span>{% endif %}</div>
        </div>
        {% endfor %}
        {% endif %}
      </div>
      {% if multi_country %}
      <div class="info-cards info-cards-row2">
        <div class="info-card">
          <div class="info-card-label">Global Ranking</div>
          <div class="info-card-value">#{{ ranking }} of {{ total_suppliers }}{% if shared %} <span class="shared-badge">(shared)</span>{% endif %}</div>
        </div>
        {% for lr in local_rankings %}
        <div class="info-card">
          <div class="info-card-label">Local Ranking ({{ lr.country }})</div>
          <div class="info-card-value">#{{ lr.rank }} of {{ lr.total }}{% if lr.shared %} <span class="shared-badge">(shared)</span>{% endif %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <!-- Compliance Gauge (Half Circle) -->
    <div class="gauge-section">
      <svg class="gauge-svg" viewBox="0 0 220 130">
        <path d="M 20 110 A 90 90 0 0 1 200 110" fill="none" stroke="#e5e7eb" stroke-width="18" stroke-linecap="round"/>
        <path d="M 20 110 A 90 90 0 0 1 200 110" fill="none" stroke="{{ gauge.color }}" stroke-width="18" stroke-linecap="round"
          stroke-dasharray="{{ gauge.dasharray }}"/>
        <text x="110" y="95" text-anchor="middle" class="gauge-text">{{ compliance_rate }}%</text>
        <text x="110" y="115" text-anchor="middle" class="gauge-label">Compliance Rate</text>
      </svg>
    </div>

    <!-- Charts: 2+1 Layout -->
    <div class="charts-row{% if multi_country %} multi-country{% endif %}{% if long_supplier_name %} long-name{% endif %}">
      <div class="charts-top">
        <div class="chart-box">
          <div class="chart-box-title">Standard Carton Usage</div>
          <canvas id="chartStdCarton"></canvas>
        </div>
        <div class="chart-box">
          <div class="chart-box-title">Product Density (Unit/CBM)</div>
          <canvas id="chartDensity"></canvas>
        </div>
      </div>
      <div class="charts-bottom">
        <div class="chart-box chart-box-full">
          <div class="chart-box-title">Monthly Compliance %</div>
          <canvas id="chartMonthlyCompliance"></canvas>
        </div>
      </div>
    </div>

<script>
    window.addEventListener('load', function() {
      window.devicePixelRatio = 2;
      requestAnimationFrame(function() {

        const chartDefaults = {
          responsive: true,
          maintainAspectRatio: false,
          animation: false,
          plugins: { legend: { display: false } },
          elements: { point: { radius: 3 } },
          scales: {
x: {
               ticks: { font: { size: 10, family: 'Arial' }, color: '#374151', maxRotation: 0, autoSkip: true, maxTicksLimit: 8 },
               grid: { display: false }
             },
             y: {
               ticks: {
                 font: { size: 10, family: 'Arial' },
                 color: '#374151',
                 callback: function(value) { return value; }
               },
              grid: { color: '#f3f4f6' },
              beginAtZero: true
            }
          }
        };

        new Chart(document.getElementById('chartStdCarton'), {
          type: 'bar',
          data: {
            labels: {{ standard_carton_labels|tojson }},
            datasets: [{ data: {{ standard_carton_scores }}, backgroundColor: '#4A90D9', borderWidth: 0, borderRadius: 3 }]
          },
          options: chartDefaults
        });

        new Chart(document.getElementById('chartMonthlyCompliance'), {
          type: 'bar',
          data: {
            labels: {{ monthly_compliance_labels|tojson }},
            datasets: [{ data: {{ monthly_compliance_scores }}, backgroundColor: '#4A90D9', borderWidth: 0, borderRadius: 3 }]
          },
          options: chartDefaults
        });

        new Chart(document.getElementById('chartDensity'), {
          type: 'line',
          data: {
            labels: {{ density_labels|tojson }},
            datasets: [{ data: {{ density_scores }}, borderColor: '#4A90D9', backgroundColor: 'transparent', tension: 0.4, fill: false, pointBackgroundColor: '#4A90D9', pointRadius: 3 }]
          },
          options: {
            ...chartDefaults,
            scales: {
              ...chartDefaults.scales,
              y: {
                ...chartDefaults.scales.y,
                ticks: {
                  ...chartDefaults.scales.y.ticks,
                  callback: function(value) { return value.toFixed(0); }
                }
              }
            }
          }
        });

      });
    });
    </script>
  </div>

  <div class="page-footer">
    <span>Generated: {{ release_date }}</span>
    <span>Page 1</span>
  </div>
</div>

<!-- PAGE 2: Factory Summary -->
<div class="page page-break">
  <div class="page-header">
    <img class="brand-img-primark" src="{{ primark_logo }}" alt="Primark">
    <img class="brand-img-allport" src="{{ allport_logo }}" alt="Allport">
  </div>

  <div class="page-content">
    <div class="section-header">
      <span class="section-title">Associated Factories</span>
      <div class="section-line"></div>
    </div>

    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Factory</th>
          <th>Origin Country</th>
          <th class="text-right">Compliance Rate (%)</th>
        </tr>
      </thead>
      <tbody>
        {% for f in associated_factories %}
        <tr>
          <td>{{ loop.index }}</td>
          <td class="text-primary">{{ f.factory }}</td>
          <td>{{ f.origin_countries }}</td>
          <td class="text-right"><strong>{{ f.compliance_rate }}%</strong></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="section-header" style="margin-top: 8px;">
      <span class="section-title">Line Details</span>
      <div class="section-line"></div>
    </div>

    <table>
      <thead>
        <tr>
          <th rowspan="2">Factory</th>
          <th colspan="2" class="text-center sub-col-header">Count</th>
          <th colspan="4" class="text-center sub-col-header">Packaging Confirmation Status</th>
        </tr>
        <tr>
          <th class="text-right sub-col">Destination PO</th>
          <th class="text-right sub-col">Reflected Lines</th>
          <th class="text-right sub-col">Pending</th>
          <th class="text-right sub-col">Approved</th>
          <th class="text-right sub-col">Rejected</th>
          <th class="text-right sub-col">Escalated</th>
        </tr>
      </thead>
      <tbody>
        {% for f in line_details %}
        <tr>
          <td class="text-primary">{{ f.factory }}</td>
          <td class="text-right">{{ f.dest_po_count }}</td>
          <td class="text-right">{{ f.reflected_lines }}</td>
          <td class="text-right text-warning">{{ f.pending }}</td>
          <td class="text-right text-success">{{ f.approved }}</td>
          <td class="text-right text-danger">{{ f.rejected }}</td>
          <td class="text-right">{{ f.escalated }}</td>
        </tr>
        {% endfor %}
        <tr class="total-row">
          <td><strong>Total</strong></td>
          <td class="text-right"><strong>{{ line_totals.dest_po_count }}</strong></td>
          <td class="text-right"><strong>{{ line_totals.reflected_lines }}</strong></td>
          <td class="text-right text-warning"><strong>{{ line_totals.pending }}</strong></td>
          <td class="text-right text-success"><strong>{{ line_totals.approved }}</strong></td>
          <td class="text-right text-danger"><strong>{{ line_totals.rejected }}</strong></td>
          <td class="text-right"><strong>{{ line_totals.escalated }}</strong></td>
        </tr>
      </tbody>
    </table>

    {% if associated_factories|length > 12 %}
    </table>
  </div>

  <div class="page-footer">
    <span>Generated: {{ release_date }}</span>
    <span>Page 2</span>
  </div>
</div>

<!-- PAGE 3: Compliance -->
<div class="page page-break">
  <div class="page-header">
    <img class="brand-img-primark" src="{{ primark_logo }}" alt="Primark">
    <img class="brand-img-allport" src="{{ allport_logo }}" alt="Allport">
  </div>

  <div class="page-content">
    <div class="section-header" style="margin-top: 8px;">
      <span class="section-title">Compliance</span>
      <div class="section-line"></div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Factory</th>
          <th class="text-right">Standard Carton Usage (%)</th>
          <th class="text-right">Corrugated Board Consumption (m²)</th>
        </tr>
      </thead>
      <tbody>
        {% for f in compliance_data %}
        <tr>
          <td class="text-primary">{{ f.factory }}</td>
          <td class="text-right">{{ f.standard_carton_pct }}%</td>
          <td class="text-right">{{ f.corrugated_sqm }} m²</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="page-footer">
    <span>Generated: {{ release_date }}</span>
    <span>Page 3</span>
  </div>
</div>
{% else %}
    </table>

    <div class="section-header" style="margin-top: 8px;">
      <span class="section-title">Compliance</span>
      <div class="section-line"></div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Factory</th>
          <th class="text-right">Standard Carton Usage (%)</th>
          <th class="text-right">Corrugated Board Consumption (m²)</th>
        </tr>
      </thead>
      <tbody>
        {% for f in compliance_data %}
        <tr>
          <td class="text-primary">{{ f.factory }}</td>
          <td class="text-right">{{ f.standard_carton_pct }}%</td>
          <td class="text-right">{{ f.corrugated_sqm }} m²</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="page-footer">
    <span>Generated: {{ release_date }}</span>
    <span>Page 2</span>
  </div>
</div>
{% endif %}

<!-- PAGE 3: Note -->
<div class="page page-break">
  <div class="page-header">
    <img class="brand-img-primark" src="{{ primark_logo }}" alt="Primark">
    <img class="brand-img-allport" src="{{ allport_logo }}" alt="Allport">
  </div>

  <div class="page-content" style="display: flex; flex-direction: column; justify-content: flex-start; padding: 20px 30px;">
    <div style="font-size: 11px; color: #000000; line-height: 1.7; text-align: justify;">
      <div style="font-weight: 700; font-size: 12px; margin-bottom: 8px;">Note:</div>
      <div style="margin-bottom: 6px;">• <strong>Compliance</strong> – Lines approved <strong>before</strong> the current HoD (Hand‑over Date).</div>
      <div style="margin-bottom: 6px;">• <strong>Non-Compliance</strong> – Includes any of the following:</div>
      <div style="margin-left: 14px; margin-bottom: 6px;">- Not submitted</div>
      <div style="margin-left: 14px; margin-bottom: 6px;">- Rejected</div>
      <div style="margin-left: 14px; margin-bottom: 6px;">- Approved, but after HoD</div>
      <div style="margin-left: 14px; margin-bottom: 8px;">- Escalated status on the HoD</div>
      <div style="margin-bottom: 6px;">• This report is generated monthly to measure supplier compliance with the Carton Optimisation Programme.</div>
      <div style="margin-bottom: 6px;">• Specifically, it assesses adherence to the requirement that carton information and photos be submitted in the TPS system for approval <strong>prior to ordering bulk cartons</strong>.</div>
      <div style="margin-bottom: 6px;">• Performance is monitored by the <strong>Primark Compliance Team</strong>, and results are shared with <strong>Sourcing</strong> for inclusion in the overall Supplier Scorecard, which is updated each season.</div>
      <div style="margin-bottom: 6px;">• Primark reserves the right to hold or reject order shipments if packaging approval has not been granted in TPS (or manually via email in cases where kimballs are missing from TPS).</div>
      <div style="margin-bottom: 10px;">• <strong>*Shared</strong> – Suppliers with identical compliance rates will be assigned the same rank. In such cases, multiple suppliers may share the same ranking position.</div>
    </div>

    <div style="margin-top: auto; display: flex; justify-content: space-between; font-size: 10px; color: #000000; padding-top: 16px; border-top: 1px solid #E5E7EB;">
      <div>
        <div style="font-weight: 600;">Prepared By,</div>
        <div style="margin-top: 6px;"><strong>Claire Xian</strong></div>
        <div>Senior Packaging Services Coordinator</div>
        <div>clairexian@pac-d.com</div>
        <div style="margin-top: 8px;"><strong>Md. Shoaib Rana</strong></div>
        <div>Packaging Coordinator</div>
        <div>shoaibrana@pac-d.com</div>
      </div>
      <div style="text-align: right;">
        <div style="font-weight: 600;">Approved By,</div>
        <div style="margin-top: 6px;"><img src="{{ dean_moss_signature }}" style="height: 35px; width: auto; display: block; margin-left: auto;" alt="Dean Moss Signature"></div>
        <div><strong>Dean Moss</strong></div>
        <div>Packaging and Compliance Manager – Supply Chain</div>
        <div>Primark</div>
        <div>dmoss@primark.co.uk</div>
      </div>
    </div>
  </div>

  <div class="page-footer">
    <span>Generated: {{ release_date }}</span>
    <span>{% if associated_factories|length > 12 %}Page 4{% else %}Page 3{% endif %}</span>
  </div>
</div>

<!-- ==================== LANDSCAPE PAGES (page-break-landscape) ==================== -->
<!-- These pages use @page landscape and will be rendered separately -->

<div class="page-break-landscape"></div>

<!-- Transaction Pages (rendered as landscape) -->
<div class="landscape-page">
  <div class="landscape-page-header">
    <img class="brand-img-primark" src="{{ primark_logo }}" alt="Primark">
    <img class="brand-img-allport" src="{{ allport_logo }}" alt="Allport">
  </div>

  <div class="landscape-page-content">
    <table class="landscape-table">
      <thead>
        <tr>
          <th class="sl-col">SL</th>
          <th class="origin-col">Origin</th>
          <th class="factory-col">Factory</th>
          <th class="destpo-col">Destination PO</th>
          <th class="kimball-col">Kimball</th>
          <th class="size-col">Size</th>
          <th class="text-right poqty-col">PO Qty</th>
          <th class="handover-col">Current Handover Date</th>
          <th class="text-right unitctn-col">Units Per Carton</th>
          <th class="dimension-col">Outer Carton Dimension (L*W*H)(mm)</th>
          <th class="supplier-col">Packaging Suppliers</th>
          <th class="updated-col">Updated Date</th>
          <th class="approved-col">Approved Date</th>
          <th class="confirm-col">Confirmation Status</th>
          <th class="compliance-col">Compliance Status</th>
        </tr>
      </thead>
      <tbody>
        {% for txn in transactions %}
        <tr>
          <td class="sl-col">{{ loop.index }}</td>
          <td class="origin-col">{{ txn.origin_country }}</td>
          <td class="factory-col">{{ txn.factory }}</td>
          <td class="destpo-col">{{ txn.destination_po }}</td>
          <td class="kimball-col">{{ txn.kimball }}</td>
          <td class="size-col">{{ txn.size }}</td>
          <td class="text-right poqty-col">{{ txn.po_qty }}</td>
          <td class="handover-col">{{ txn.handover_date }}</td>
          <td class="text-right unitctn-col">{{ txn.units_per_carton }}</td>
          <td class="dimension-col">{{ txn.carton_length_mm|default(0)|int }}×{{ txn.carton_width_mm|default(0)|int }}×{{ txn.carton_height_mm|default(0)|int }}</td>
          <td class="supplier-col">{{ txn.packaging_supplier }}</td>
          <td class="updated-col">{{ txn.updated_date }}</td>
          <td class="approved-col">{{ txn.approved_date }}</td>
          <td class="confirm-col">
            {% if txn.packaging_status == 'Approved' %}
            <span class="status-badge success">{{ txn.packaging_status }}</span>
            {% elif txn.packaging_status in ['Pending', 'Escalated'] %}
            <span class="status-badge warning">{{ txn.packaging_status }}</span>
            {% else %}
            <span class="status-badge danger">{{ txn.packaging_status }}</span>
            {% endif %}
          </td>
          <td class="compliance-col">
            {% if txn.compliance_status == 'Compliant' %}
            <span class="status-badge success">{{ txn.compliance_status }}</span>
            {% else %}
            <span class="status-badge danger">{{ txn.compliance_status }}</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="landscape-footer">
    <span>Generated: {{ release_date }}</span>
    <span>TPS Transaction Report</span>
  </div>
</div>

</body>
</html>