<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
{{ report_head|safe }}
{#- Logos, "Generated" date and page numbers are the PDF's print header/footer (reports/pdf.py),
    so every page gets them, including pages a long table flows onto. -#}
<style>
  :root { --navy:#002A62; --cyan:#00A2D3; --tint:#E8F6FB; --ink:#1f2937; --muted:#5b7486; --line:#edf2f6; }
  .tone-high { --tone:#059669; --tone-bg:#ecfdf5; }
  .tone-mid { --tone:#d97706; --tone-bg:#fffbeb; }
  .tone-low { --tone:#dc2626; --tone-bg:#fef2f2; }
  * { box-sizing:border-box; margin:0; padding:0; }
  @page { size:A4; margin:22mm 0 14mm; }
  html, body { background:#fff; }
  body { font-family:Inter, sans-serif; font-size:11px; line-height:1.4; color:var(--ink); font-variant-numeric:tabular-nums;
         -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  .sheet { padding:0 30px; }
  .k { font-size:8px; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:0.6px; }
  .shared { display:inline-block; background:#FFF1D6; color:#8a5a00; font-size:7.5px; font-weight:800; letter-spacing:0.6px;
            text-transform:uppercase; padding:2px 8px; border-radius:20px; }

  /* Page 1 - fixed to one page; the chart cards take whatever height is left */
  .p1 { width:calc(210mm - 60px); height:261mm; display:flex; flex-direction:column; gap:14px; padding-top:4px; break-after:page; }
  .rt { display:flex; justify-content:space-between; align-items:center; padding:2px 6px 0; }
  .rt1 { font-size:24px; font-weight:800; color:var(--navy); letter-spacing:-0.5px; }
  .rt2 { font-size:10px; font-weight:700; color:var(--cyan); text-transform:uppercase; letter-spacing:2.5px; margin-top:4px; }
  .rt3 { font-size:11px; font-weight:700; color:#fff; background:var(--navy); padding:7px 16px; border-radius:20px; white-space:nowrap; }
  .hero { background:var(--navy); border-radius:26px; color:#fff; padding:20px 24px 60px; display:grid; grid-template-columns:1fr auto;
          gap:18px; align-items:center; position:relative; overflow:hidden; }
  .hero::after { content:''; position:absolute; right:-40px; top:-60px; width:220px; height:220px; border-radius:50%; background:rgba(0,162,211,0.25); }
  .hero::before { content:''; position:absolute; right:120px; bottom:-120px; width:200px; height:200px; border-radius:50%; background:rgba(0,162,211,0.12); }
  .hero > * { position:relative; z-index:1; }
  .hero .k { color:#8fc9e6; }
  .hero .name { font-size:21px; font-weight:800; line-height:1.2; letter-spacing:-0.3px; margin-top:2px; }
  .chips { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
  .chips span { background:rgba(255,255,255,0.12); border-radius:20px; padding:4px 11px; font-size:9.5px; }
  .global { text-align:right; }
  .global .v { font-size:50px; font-weight:800; letter-spacing:-2px; line-height:1; margin-top:2px; }
  .global .of { font-size:11px; color:#cfe6f3; margin-top:2px; }
  .global .shared { margin-top:6px; }
  .cards { display:grid; grid-template-columns:1fr 0.7fr 1.2fr; gap:10px; margin:-54px 14px 0; position:relative; z-index:2; }
  .card { background:#fff; border-radius:18px; padding:12px 14px; border:1px solid var(--line); }
  .cards .card { display:flex; flex-direction:column; }
  .kh { display:flex; justify-content:space-between; align-items:center; height:16px; }
  .pill { display:inline-block; background:var(--tone-bg); color:var(--tone); font-size:7.5px; font-weight:800; padding:2px 8px;
          border-radius:20px; text-transform:uppercase; letter-spacing:0.6px; }
  .sub { font-size:8.5px; color:var(--muted); }
  /* The rate and factory values sit on one baseline: both cards have the same bar + caption row under them. */
  .big { margin-top:auto; padding-top:6px; text-align:right; font-size:var(--val-size); font-weight:800; letter-spacing:-1px;
         line-height:1; color:var(--navy); }
  .rate .big { color:var(--tone); }
  .foot { margin-top:6px; }
  .bar { height:6px; border-radius:3px; background:#eef2f6; overflow:hidden; }
  .bar i { display:block; height:100%; border-radius:3px; background:var(--tone); }
  .seg { display:flex; gap:2px; height:6px; border-radius:3px; overflow:hidden; }
  .seg i { display:block; height:100%; background:var(--tone); }
  .legend { display:flex; justify-content:space-between; height:13px; line-height:13px; margin-top:5px; font-size:8.5px; color:var(--muted); }
  .legend b { font-size:10px; margin-right:1px; color:var(--navy); }
  .legend b.t { color:var(--tone); }
  .local .row { display:flex; justify-content:space-between; align-items:center; padding:4px 0; border-top:1px solid #eef3f6; font-size:10px; color:var(--navy); }
  .local .row b { font-size:13px; }
  .local .row small { color:var(--muted); font-size:9px; }
  .local .row .r { display:flex; align-items:center; gap:8px; }
  .charts { flex:1; min-height:0; display:grid; grid-template-rows:1fr 1fr; gap:12px; padding-bottom:14px; }
  .charts .two { display:grid; grid-template-columns:1fr 1fr; gap:12px; min-height:0; }
  .chart-card { background:#fff; border:1px solid var(--line); border-radius:20px; padding:12px 16px; display:flex; flex-direction:column;
                min-height:0; }
  .chart-card .h { display:flex; justify-content:space-between; align-items:baseline; font-size:10.5px; font-weight:800; color:var(--navy); }
  .chart-card .h small { font-weight:600; color:var(--muted); font-size:8.5px; background:var(--tint); padding:2px 8px; border-radius:10px; }
  .chart { position:relative; flex:1; min-height:0; margin-top:4px; }

  /* Tables - long ones flow onto further pages with their header row repeated */
  .sec { display:flex; align-items:center; gap:10px; font-size:13px; font-weight:800; color:var(--navy); margin:4px 0 8px; break-after:avoid; }
  .sec::before { content:''; width:10px; height:10px; border-radius:50%; border:3px solid var(--cyan); }
  .sec::after { content:''; flex:1; height:1px; background:var(--line); }
  .sec small { font-weight:600; font-size:9px; color:var(--muted); background:var(--tint); padding:2px 8px; border-radius:10px; }
  .block + .block { margin-top:18px; }
  table { width:100%; border-collapse:separate; border-spacing:0; font-size:8.5px; line-height:1.25; }
  thead { display:table-header-group; }
  tr { break-inside:avoid; }
  th { background:var(--navy); color:#fff; font-size:7px; font-weight:700; text-transform:uppercase; letter-spacing:0.4px; padding:5px 6px; text-align:left; }
  th.grp { color:#7fd3ee; border-bottom:1px solid #1d4a80; }
  thead tr:first-child th:first-child { border-top-left-radius:12px; }
  thead tr:first-child th:last-child { border-top-right-radius:12px; }
  td { padding:3px 6px; border-bottom:1px solid var(--line); color:#374151; }
  .r { text-align:right; } .c { text-align:center; }
  .fac { color:var(--navy); font-weight:600; }
  .ok { color:#059669; font-weight:600; } .bad { color:#dc2626; font-weight:600; } .warn { color:#d97706; font-weight:600; }
  tr.total td { font-weight:700; color:var(--navy); border-top:2px solid var(--navy); border-bottom:none; }
  .rate-cell { display:flex; justify-content:flex-end; align-items:center; gap:8px; }
  .rate-cell b { width:38px; text-align:right; }
  .ratebar { width:60px; height:5px; border-radius:3px; background:#eef2f6; overflow:hidden; }
  .ratebar i { display:block; height:100%; border-radius:3px; background:var(--tone); }

  /* Notes */
  .notes { break-before:page; height:261mm; display:flex; flex-direction:column; gap:16px; padding-top:4px; }
  .note-card { background:var(--tint); border-radius:22px; padding:20px 24px; }
  .note-card h3 { font-size:13px; font-weight:800; color:var(--navy); margin-bottom:10px; }
  .note-card ul { list-style:none; display:flex; flex-direction:column; gap:7px; font-size:10.5px; line-height:1.55; color:#1f2937; }
  .note-card li { position:relative; padding-left:16px; }
  .note-card li::before { content:''; position:absolute; left:0; top:6px; width:7px; height:7px; border-radius:50%; background:var(--cyan); }
  .note-card ul.dash { margin-top:5px; gap:3px; }
  .note-card ul.dash li { padding-left:14px; }
  .note-card ul.dash li::before { content:'-'; width:auto; height:auto; top:0; background:none; border-radius:0; color:var(--muted); }
  .sign { margin-top:auto; display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .sign .card { box-shadow:none; border:1px solid var(--line); font-size:10px; color:#374151; line-height:1.5; }
  .sign .who + .who { margin-top:10px; padding-top:10px; border-top:1px solid var(--line); }
  .sign b { color:var(--navy); font-size:11px; }
  .sign .sig { height:34px; width:auto; display:block; margin:4px 0 2px; }

  /* Transactions: A4 landscape pages in the same document */
  @page wide { size:297mm 210mm; margin:20mm 0 13mm; }
  .wide { page:wide; break-before:page; }
  .wide table { table-layout:fixed; }
  .wide td { overflow-wrap:break-word; vertical-align:top; }
  .wide th { vertical-align:bottom; padding:5px; }
  .st { display:inline-block; padding:1px 7px; border-radius:20px; font-size:7px; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; }
  .st.ok { background:#d1fae5; color:#047857; } .st.bad { background:#fee2e2; color:#b91c1c; } .st.warn { background:#fef3c7; color:#b45309; }
</style>
</head>
<body>
{% set band_labels = {'high': '70%+', 'mid': '40–70%', 'low': 'Below 40%'} %}
<div class="sheet">

  <section class="p1">
    <div class="rt">
      <div>
        <div class="rt1">Transit Packaging System (TPS)</div>
        <div class="rt2">Compliance Report (Initial Lines only)</div>
      </div>
      <div class="rt3">{{ month_name }} {{ year }}</div>
    </div>
    <div>
      <div class="hero">
        <div>
          <div class="k">Supplier</div>
          <div class="name">{{ supplier_name }}</div>
          <div class="chips">{% for c in (kpis.origin_country or '').split(', ') if c %}<span>{{ c }}</span>{% endfor %}</div>
        </div>
        <div class="global">
          <div class="k">Global ranking</div>
          <div class="v">#{{ ranking }}</div>
          <div class="of">of {{ total_suppliers }} suppliers</div>
          {% if shared %}<span class="shared">Shared</span>{% endif %}
        </div>
      </div>
      {#- The local-ranking card sets the row height, so the two values grow with its row count. #}
      <div class="cards" style="--val-size:{{ [28, 28, 34, 42, 46][[local_rankings|length, 4]|min] }}px">
        <div class="card rate tone-{{ band }}">
          <div class="kh"><span class="k">Compliance rate</span><span class="pill">{{ band_labels[band] }}</span></div>
          <div class="big">{{ compliance_rate }}%</div>
          <div class="foot">
            <div class="bar"><i style="width:{{ compliance_rate }}%"></i></div>
            <div class="legend"><span><b class="t">{{ "{:,}".format(kpis.compliant_count) }}</b> compliant lines</span><span><b>{{ "{:,}".format(kpis.total_lines) }}</b> total</span></div>
          </div>
        </div>
        <div class="card">
          <div class="kh"><span class="k">Factories</span><span class="sub">This month</span></div>
          <div class="big">{{ kpis.factory_count }}</div>
          <div class="foot">
            <div class="seg">{% for b in ('high', 'mid', 'low') if factory_bands[b] %}<i class="tone-{{ b }}" style="flex:{{ factory_bands[b] }}"></i>{% endfor %}</div>
            <div class="legend">{% for b, label in (('high', '70%+'), ('mid', '40–70%'), ('low', '<40%')) %}<span><b class="t tone-{{ b }}">{{ factory_bands[b] }}</b> {{ label }}</span>{% endfor %}</div>
          </div>
        </div>
        <div class="card local">
          <div class="kh" style="margin-bottom:2px"><span class="k">Local ranking</span></div>
          {% for lr in local_rankings %}
          <div class="row"><span>{{ lr.country }}</span><span class="r">{% if lr.shared %}<span class="shared">Shared</span>{% endif %}<span><b>#{{ lr.rank }}</b> <small>of {{ lr.total }}</small></span></span></div>
          {% endfor %}
        </div>
      </div>
    </div>
    <div class="charts">
      <div class="chart-card"><div class="h">Monthly Compliance<small>%</small></div><div class="chart"><canvas id="chartMonthlyCompliance"></canvas></div></div>
      <div class="two">
        <div class="chart-card"><div class="h">Standard Carton Usage<small>%</small></div><div class="chart"><canvas id="chartStdCarton"></canvas></div></div>
        <div class="chart-card"><div class="h">Product Density<small>Unit/CBM</small></div><div class="chart"><canvas id="chartDensity"></canvas></div></div>
      </div>
    </div>
  </section>

  <section>
    <div class="block">
      <div class="sec">Associated Factories</div>
      <table>
        <thead><tr><th style="width:26px">#</th><th>Factory</th><th>Origin country</th><th class="r" style="width:130px">Compliance rate</th></tr></thead>
        <tbody>
        {% for f in associated_factories %}
          <tr><td>{{ loop.index }}</td><td class="fac">{{ f.factory }}</td><td>{{ f.origin_countries }}</td>
              <td><div class="rate-cell"><div class="ratebar"><i class="tone-{{ f.band }}" style="width:{{ f.compliance_rate }}%"></i></div><b>{{ f.compliance_rate }}%</b></div></td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="block">
      <div class="sec">Line Details</div>
      <table>
        <thead>
          <tr><th rowspan="2">Factory</th><th colspan="2" class="c grp">Count</th><th colspan="4" class="c grp">Packaging confirmation status</th></tr>
          <tr><th class="r">Destination PO</th><th class="r">Reflected lines</th><th class="r">Pending</th><th class="r">Approved</th><th class="r">Rejected</th><th class="r">Escalated</th></tr>
        </thead>
        <tbody>
        {% for f in line_details %}
          <tr><td class="fac">{{ f.factory }}</td><td class="r">{{ f.dest_po_count }}</td><td class="r">{{ f.reflected_lines }}</td>
              <td class="r warn">{{ f.pending }}</td><td class="r ok">{{ f.approved }}</td><td class="r bad">{{ f.rejected }}</td><td class="r">{{ f.escalated }}</td></tr>
        {% endfor %}
          <tr class="total"><td>Total</td><td class="r">{{ line_totals.dest_po_count }}</td><td class="r">{{ line_totals.reflected_lines }}</td>
              <td class="r">{{ line_totals.pending }}</td><td class="r">{{ line_totals.approved }}</td><td class="r">{{ line_totals.rejected }}</td><td class="r">{{ line_totals.escalated }}</td></tr>
        </tbody>
      </table>
    </div>
    <div class="block">
      <div class="sec">Standard Carton Usage</div>
      <table>
        <thead><tr><th>Factory</th><th class="r">Standard carton usage (%)</th><th class="r">Corrugated board consumption (m²)</th></tr></thead>
        <tbody>
        {% for f in compliance_data %}
          <tr><td class="fac">{{ f.factory }}</td><td class="r">{{ f.standard_carton_pct }}%</td><td class="r">{{ f.corrugated_sqm }} m²</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="notes">
    <div class="note-card">
      <h3>Note:</h3>
      <ul>
        <li><strong>Compliance</strong> – Lines approved <strong>before</strong> the current HoD (Hand‑over Date).</li>
        <li><strong>Non-Compliance</strong> – Includes any of the following:
          <ul class="dash"><li>Not submitted</li><li>Rejected</li><li>Approved, but after HoD</li><li>Escalated status on the HoD</li></ul>
        </li>
        <li>This report is generated monthly to measure supplier compliance with the Carton Optimisation Programme.</li>
        <li>Specifically, it assesses adherence to the requirement that carton information and photos be submitted in the TPS system for approval <strong>prior to ordering bulk cartons</strong>.</li>
        <li>Performance is monitored by the <strong>Primark Compliance Team</strong>, and results are shared with <strong>Sourcing</strong> for inclusion in the overall Supplier Scorecard, which is updated each season.</li>
        <li>Primark reserves the right to hold or reject order shipments if packaging approval has not been granted in TPS (or manually via email in cases where kimballs are missing from TPS).</li>
        <li><strong>*Shared</strong> – Suppliers with identical compliance rates will be assigned the same rank. In such cases, multiple suppliers may share the same ranking position.</li>
      </ul>
    </div>
    <div class="sign">
      <div class="card">
        <div class="k" style="margin-bottom:6px">Prepared By,</div>
        <div class="who"><b>Claire Xian</b><br>Senior Packaging Services Coordinator<br>clairexian@pac-d.com</div>
        <div class="who"><b>Md. Shoaib Rana</b><br>Packaging Coordinator<br>shoaibrana@pac-d.com</div>
      </div>
      <div class="card" style="text-align:right">
        <div class="k">Approved By,</div>
        <img class="sig" style="margin-left:auto" src="{{ dean_moss_signature }}" alt="Dean Moss signature">
        <b>Dean Moss</b><br>Packaging and Compliance Manager – Supply Chain<br>Primark<br>dmoss@primark.co.uk
      </div>
    </div>
  </section>

  <section class="wide">
    <div class="sec">Transaction Details <small>{{ supplier_name }} · {{ month_name }} {{ year }}</small></div>
    <table>
      <colgroup><col style="width:24px"><col style="width:58px"><col style="width:150px"><col style="width:62px"><col style="width:44px"><col style="width:84px">
        <col style="width:40px"><col style="width:56px"><col style="width:36px"><col style="width:72px"><col style="width:150px"><col style="width:56px"><col style="width:56px"><col style="width:70px"><col style="width:76px"></colgroup>
      <thead><tr><th>SL</th><th>Origin</th><th>Factory</th><th>Destination PO</th><th>Kimball</th><th>Size</th><th class="r">PO Qty</th><th>Current handover date</th>
        <th class="r">Units per carton</th><th>Outer carton (L×W×H mm)</th><th>Packaging supplier</th><th>Updated date</th><th>Approved date</th><th>Confirmation status</th><th>Compliance status</th></tr></thead>
      <tbody>
      {% for t in transactions %}
        <tr><td>{{ loop.index }}</td><td>{{ t.origin_country }}</td><td class="fac">{{ t.factory }}</td><td>{{ t.destination_po }}</td><td>{{ t.kimball }}</td><td>{{ t.size }}</td>
          <td class="r">{{ t.po_qty }}</td><td>{{ t.handover_date }}</td><td class="r">{{ t.units_per_carton }}</td>
          <td>{{ t.carton_length_mm|default(0)|int }}×{{ t.carton_width_mm|default(0)|int }}×{{ t.carton_height_mm|default(0)|int }}</td>
          <td>{{ t.packaging_supplier }}</td><td>{{ t.updated_date }}</td><td>{{ t.approved_date }}</td>
          <td><span class="st {{ 'ok' if t.packaging_status == 'Approved' else 'warn' if t.packaging_status in ['Pending', 'Escalated'] else 'bad' }}">{{ t.packaging_status }}</span></td>
          <td><span class="st {{ 'ok' if t.compliance_status == 'Compliant' else 'bad' }}">{{ t.compliance_status }}</span></td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

</div>
<script>
// Charts draw during the load event, so they are final when Playwright's set_content(wait_until="load") returns.
window.addEventListener('load', function () {
  const C = { bar:'#b8e4f2', now:'#002A62', grid:'#e8eef3', tick:'#5b7486', label:'#002A62', line:'#00A2D3', area:'rgba(0,162,211,0.10)' };
  Chart.defaults.font.family = 'Inter'; Chart.defaults.font.size = 9; Chart.defaults.color = C.tick;
  const labels = (fmt) => ({ id:'valueLabels', afterDatasetsDraw(c) {
    const { ctx } = c; ctx.save(); ctx.font = '600 9px Inter'; ctx.textAlign = 'center'; ctx.fillStyle = C.label;
    c.getDatasetMeta(0).data.forEach((el, i) => { const v = c.data.datasets[0].data[i]; if (v != null) ctx.fillText(fmt(v), el.x, el.y - 6); });
    ctx.restore(); } });
  const opts = (fmt) => ({ responsive:true, devicePixelRatio:3, maintainAspectRatio:false, animation:false, layout:{ padding:{ top:16 } },
    plugins:{ legend:{ display:false } }, datasets:{ bar:{ categoryPercentage:0.6, barPercentage:0.9 } },
    scales:{ x:{ grid:{ display:false }, border:{ color:C.grid }, ticks:{ maxRotation:0, autoSkip:false } },
             y:{ display:false, beginAtZero:true, ticks:{ callback:fmt } } } });
  const pct = (v) => Math.round(v) + '%';
  // The report month (last point) is highlighted.
  const last = (n, a, b) => Array.from({ length:n }, (_, i) => i === n - 1 ? a : b);
  const bars = (id, l, d) => new Chart(document.getElementById(id), { type:'bar',
    data:{ labels:l, datasets:[{ data:d, backgroundColor:last(d.length, C.now, C.bar), borderRadius:7, maxBarThickness:34 }] },
    options:opts(pct), plugins:[labels(pct)] });
  bars('chartMonthlyCompliance', {{ monthly_compliance_labels|tojson }}, {{ monthly_compliance_scores|tojson }});
  bars('chartStdCarton', {{ standard_carton_labels|tojson }}, {{ standard_carton_scores|tojson }});
  const d = {{ density_scores|tojson }};
  new Chart(document.getElementById('chartDensity'), { type:'line',
    data:{ labels:{{ density_labels|tojson }}, datasets:[{ data:d, borderColor:C.line, borderWidth:2, fill:true, backgroundColor:C.area, tension:0.35, spanGaps:true,
      pointRadius:last(d.length, 4, 2.5), pointBackgroundColor:last(d.length, C.now, C.line), pointBorderWidth:0 }] },
    options:opts((v) => v.toFixed(0)), plugins:[labels((v) => Math.round(v))] });
});
</script>
</body>
</html>
