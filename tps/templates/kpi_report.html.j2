<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
{{ report_head|safe }}
{#- Logos, "Generated" date and page numbers are the PDF's print header/footer (reports/pdf.py). -#}
<style>
  :root { --navy:#002A62; --cyan:#00A2D3; --tint:#E8F6FB; --ink:#1f2937; --muted:#5b7486; --line:#edf2f6; }
  * { box-sizing:border-box; margin:0; padding:0; }
  @page { size:A4; margin:22mm 0 14mm; }
  html, body { background:#fff; }
  body { font-family:Inter, sans-serif; font-size:11px; line-height:1.4; color:var(--ink); font-variant-numeric:tabular-nums;
         -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  .sheet { padding:0 30px; }
  /* Page 1 may flow onto another page if the tables grow; the chart page is fixed to one page. */
  .page { width:calc(210mm - 60px); display:flex; flex-direction:column; gap:14px; padding-top:4px; }
  .page + .page { break-before:page; height:261mm; }
  .k { font-size:8px; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:0.6px; }
  .rt { display:flex; justify-content:space-between; align-items:center; padding:2px 6px 0; }
  .rt1 { font-size:24px; font-weight:800; color:var(--navy); letter-spacing:-0.5px; }
  .rt2 { font-size:10px; font-weight:700; color:var(--cyan); text-transform:uppercase; letter-spacing:2.5px; margin-top:4px; }
  .rt3 { font-size:11px; font-weight:700; color:#fff; background:var(--navy); padding:7px 16px; border-radius:20px; white-space:nowrap; }
  .delta { display:inline-block; font-size:8px; font-weight:800; padding:2px 7px; border-radius:20px; background:rgba(255,255,255,0.16);
           color:#fff; white-space:nowrap; }
  .bd-c { background:var(--navy); } .cn-c { background:var(--cyan); }
  .dot { display:inline-block; width:8px; height:8px; border-radius:2px; margin-right:5px; vertical-align:-1px; }

  /* Hero band with the region cards overlapping its bottom edge */
  .hero { background:var(--navy); border-radius:26px; color:#fff; padding:20px 24px 64px; display:grid; grid-template-columns:1fr auto; gap:28px;
          align-items:center; position:relative; overflow:hidden; }
  .hero::after { content:''; position:absolute; right:-40px; top:-60px; width:220px; height:220px; border-radius:50%; background:rgba(0,162,211,0.25); }
  .hero::before { content:''; position:absolute; right:150px; bottom:-120px; width:200px; height:200px; border-radius:50%; background:rgba(0,162,211,0.12); }
  .hero > * { position:relative; z-index:1; }
  .hero .k { color:#8fc9e6; }
  .hv { font-size:50px; font-weight:800; letter-spacing:-2px; line-height:1; margin-top:6px; }
  .hs { font-size:10.5px; color:#cfe6f3; margin-top:10px; display:flex; align-items:center; gap:8px; }
  .hstats { display:flex; }
  .hstats > div { padding:0 22px; display:flex; flex-direction:column; gap:6px; }
  .hstats > div + div { border-left:1px solid rgba(255,255,255,0.16); }
  .hstats b { font-size:34px; font-weight:800; letter-spacing:-1px; line-height:1; }
  .hstats small { font-size:8.5px; color:#cfe6f3; display:flex; align-items:center; gap:6px; min-height:15px; }
  .cards { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin:-56px 14px 0; position:relative; z-index:2; }
  .card { background:#fff; border-radius:18px; padding:12px 14px; border:1px solid var(--line);
          display:flex; flex-direction:column; }
  .kh { display:flex; justify-content:space-between; align-items:center; height:16px; }
  .tag { display:inline-flex; align-items:center; font-size:11px; font-weight:800; color:var(--navy); }
  .body { display:flex; justify-content:space-between; align-items:flex-end; margin-top:auto; padding-top:8px; }
  .mini { display:flex; gap:16px; }
  .mini div { display:flex; flex-direction:column; }
  .mini small { font-size:7px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--muted); }
  .mini b { font-size:14px; font-weight:800; color:var(--navy); }
  .big { font-size:40px; font-weight:800; letter-spacing:-1px; line-height:1; color:var(--navy); }
  .big em { font-style:normal; font-size:10px; font-weight:600; color:var(--muted); margin-left:4px; letter-spacing:0; }
  .bar { height:6px; border-radius:3px; background:#eef2f6; overflow:hidden; margin-top:8px; }
  .bar i { display:block; height:100%; border-radius:3px; }
  .foot { display:flex; justify-content:space-between; padding-top:4px; font-size:8.5px; color:var(--muted); }
  .foot b { color:var(--navy); }

  /* Tables - a long one carries on onto the next page with its header row repeated */
  .sec { display:flex; align-items:center; gap:10px; font-size:13px; font-weight:800; color:var(--navy); margin:2px 0 -4px; break-after:avoid; }
  .sec::before { content:''; width:10px; height:10px; border-radius:50%; border:3px solid var(--cyan); }
  .sec::after { content:''; flex:1; height:1px; background:var(--line); order:2; }
  .sec small { order:3; font-weight:600; font-size:9px; color:var(--muted); background:var(--tint); padding:2px 8px; border-radius:10px; }
  table { width:100%; border-collapse:separate; border-spacing:0; font-size:9px; line-height:1.25; }
  thead { display:table-header-group; }
  tr { break-inside:avoid; }
  th { background:var(--navy); color:#fff; font-size:7px; font-weight:700; text-transform:uppercase; letter-spacing:0.4px; padding:5px 7px; text-align:left; }
  th.grp { color:#7fd3ee; border-bottom:1px solid #1d4a80; text-align:center; }
  thead tr:first-child th:first-child { border-top-left-radius:12px; }
  thead tr:first-child th:last-child { border-top-right-radius:12px; }
  td { padding:4.5px 7px; border-bottom:1px solid var(--line); color:#374151; }
  .r { text-align:right; }
  .now { color:var(--navy); font-weight:700; } .was { color:#8a9aa8; }
  .name { font-weight:600; color:var(--navy); }
  tr.total td { font-weight:700; color:var(--navy); border-top:2px solid var(--navy); border-bottom:none; }
  .meter { display:flex; align-items:center; justify-content:flex-end; gap:8px; }
  .meter .t { height:6px; border-radius:3px; background:#eef2f6; overflow:hidden; }
  .meter i { display:block; height:100%; border-radius:3px; }
  .meter b { text-align:right; color:var(--navy); }
  .share .t { width:70px; } .share b { width:30px; font-weight:600; }
  .perf .t { width:120px; } .perf b { width:36px; }

  /* Charts */
  .chart-card { flex:1; background:#fff; border:1px solid var(--line); border-radius:20px; padding:12px 16px; display:flex; flex-direction:column;
                min-height:0; }
  .chart-card .h { display:flex; justify-content:space-between; align-items:center; font-size:10.5px; font-weight:800; color:var(--navy); }
  .chart { position:relative; flex:1; min-height:0; margin-top:4px; }
  .lg { display:flex; gap:12px; font-size:8.5px; font-weight:600; color:var(--muted); }
  .ls { display:inline-block; width:16px; border-top:2px solid var(--muted); margin-right:5px; vertical-align:middle; }
  .ls.dash { border-top-style:dashed; }
</style>
</head>
<body>
{% macro n(v) %}{{ "{:,}".format(v) }}{% endmacro %}
{% macro change(c) %}{% if c is not none %}<span class="delta">{{ '↑' if c >= 0 else '↓' }} {{ c|abs }}%</span>{% endif %}{% endmacro %}
{% set h = headline %}
<div class="sheet">
  <section class="page">
    <div class="rt">
      <div><div class="rt1">Transit Packaging System (TPS)</div><div class="rt2">KPI Report</div></div>
      <div class="rt3">{{ month_name }} {{ year }}</div>
    </div>
    <div>
      <div class="hero">
        <div>
          <div class="k">Reflected lines this month</div>
          <div class="hv">{{ n(h.lines.now) }}</div>
          {% if h.previous_label %}<div class="hs">{{ change(h.lines.change) }}vs {{ h.previous_label }} · {{ n(h.lines.before) }} lines</div>{% endif %}
        </div>
        <div class="hstats">
          {% for label, s in (('Suppliers', h.suppliers), ('Factories', h.factories)) %}
          <div><span class="k">{{ label }}</span><b>{{ n(s.now) }}</b>
            <small>{% if h.previous_label %}{{ change(s.change) }}{{ h.previous_label }}: {{ n(s.before) }}{% endif %}</small></div>
          {% endfor %}
        </div>
      </div>
      <div class="cards">
        {% for key, label, lines, share in (('bd', 'BD Region', h.bd_lines, h.bd_share), ('cn', 'CN Region', h.cn_lines, h.cn_share)) %}{% set a = avg_per_day[key] %}
        <div class="card">
          <div class="kh"><span class="tag"><i class="dot {{ key }}-c"></i>{{ label }}</span><span class="k">Average lines processed per day</span></div>
          <div class="body">
            <div class="mini">
              <div><small>Processed</small><b>{{ n(a.lines) }}</b></div>
              <div><small>Working days</small><b>{{ a.working_days }}</b></div>
            </div>
            <div class="big">{{ a.avg }}<em>/ day</em></div>
          </div>
          <div class="bar"><i class="{{ key }}-c" style="width:{{ share }}%"></i></div>
          <div class="foot"><span><b>{{ n(lines) }}</b> reflected lines</span><span><b>{{ share }}%</b> of total</span></div>
        </div>
        {% endfor %}
      </div>
    </div>

    {% if monthly_tables %}
    <div class="sec">Monthly Summary</div>
    <table>
      <thead>
        <tr><th rowspan="2">Country</th>
          {% for group in ('Suppliers', 'Factories', 'Reflected Lines') %}<th class="grp" colspan="{{ months|length }}">{{ group }}</th>{% endfor %}
          <th rowspan="2" class="r">Share · {{ months[0] }}</th></tr>
        <tr>{% for _ in range(3) %}{% for m in months %}<th class="r">{{ m }}</th>{% endfor %}{% endfor %}</tr>
      </thead>
      <tbody>
        {% for row in comparison %}
        <tr>
          <td class="name">{{ row.country }}</td>
          {% for key in ('suppliers', 'factories', 'reflected_lines') %}{% for cell in row.cells %}<td class="r {{ 'now' if loop.first else 'was' }}">{{ n(cell[key]) if cell else '–' }}</td>{% endfor %}{% endfor %}
          <td><div class="meter share"><div class="t"><i class="{{ row.region }}-c" style="width:{{ row.share }}%"></i></div><b>{{ row.share }}%</b></div></td>
        </tr>
        {% endfor %}
        <tr class="total"><td>Total</td>
          {% for key in ('suppliers', 'factories', 'reflected_lines') %}{% for t in monthly_tables %}<td class="r">{{ n(t.totals[key]) }}</td>{% endfor %}{% endfor %}
          <td class="r">100%</td></tr>
      </tbody>
    </table>
    {% endif %}

    <div class="sec">Individual Performance<small>Lines approved</small></div>
    <table>
      <thead><tr><th>Approved By</th>{% for m in performance.month_labels %}<th class="r">{{ m }}</th>{% endfor %}</tr></thead>
      <tbody>
        {% for row in performance.rows %}
        <tr><td class="name">{{ row.approved_by }}</td>
          {% for v in row.lines %}{% if loop.first %}
          <td class="r"><div class="meter perf"><div class="t"><i class="bd-c" style="width:{{ (v / performance_max * 100) if performance_max else 0 }}%"></i></div><b>{{ n(v) }}</b></div></td>
          {% else %}<td class="r was">{{ n(v) }}</td>{% endif %}{% endfor %}</tr>
        {% else %}
        <tr><td colspan="{{ 1 + performance.month_labels|length }}">No approved-by data available.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="page">
    <div class="sec">12-Month Trend</div>
    <div class="chart-card">
      <div class="h">Suppliers &amp; Factories<span class="lg"><span><i class="dot bd-c"></i>BD Region</span><span><i class="dot cn-c"></i>CN Region</span>
        <span><i class="ls"></i>Suppliers</span><span><i class="ls dash"></i>Factories</span></span></div>
      <div class="chart"><canvas id="chartTrend"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="h">Reflected Lines — BD &amp; CN Regions<span class="lg"><span><i class="dot bd-c"></i>BD Region</span><span><i class="dot cn-c"></i>CN Region</span></span></div>
      <div class="chart"><canvas id="chartRegion"></canvas></div>
    </div>
  </section>
</div>
<script>
// Charts draw during the load event, so they are final when Playwright's set_content(wait_until="load") returns.
window.addEventListener('load', function () {
  const C = { navy:'#002A62', cyan:'#00A2D3', cyanText:'#0083ab', grid:'#e8eef3', tick:'#5b7486' };
  Chart.defaults.font.family = 'Inter'; Chart.defaults.font.size = 9; Chart.defaults.color = C.tick;
  const k = (v) => v >= 1000 ? (v / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(v);
  // Datasets come in BD/CN pairs. On lines, the higher of a pair is labelled above its point and the lower below, so they never overlap.
  const labels = (fmt, bars) => ({ id:'valueLabels', afterDatasetsDraw(c) {
    const { ctx } = c; const sets = c.data.datasets; ctx.save(); ctx.font = '600 8.5px Inter'; ctx.textAlign = 'center';
    sets.forEach((ds, di) => { const other = sets[di ^ 1]; ctx.fillStyle = ds.labelColor;
      c.getDatasetMeta(di).data.forEach((el, i) => { const v = ds.data[i]; if (v == null) return;
        const above = bars || v > other.data[i] || (v === other.data[i] && di % 2 === 0);
        ctx.fillText(fmt(v), el.x, above ? el.y - 7 : el.y + 15); }); });
    ctx.restore(); } });
  const opts = (bar) => ({ responsive:true, devicePixelRatio:3, maintainAspectRatio:false, animation:false, layout:{ padding:{ top:18, bottom:bar ? 0 : 12, left:8, right:8 } },
    plugins:{ legend:{ display:false } }, datasets:{ bar:{ categoryPercentage:0.72, barPercentage:0.92 } },
    scales:{ x:{ offset:true, grid:{ display:false }, border:{ color:C.grid }, ticks:{ maxRotation:0, autoSkip:false } },
             y:{ display:false, beginAtZero:true } } });
  const line = (color, data, dash) => ({ data, borderColor:color, backgroundColor:color, labelColor:color === C.cyan ? C.cyanText : color,
    borderWidth:2, borderDash:dash ? [5, 4] : [], cubicInterpolationMode:'monotone', pointRadius:3 });
  new Chart(document.getElementById('chartTrend'), { type:'line', data:{ labels:{{ trend.labels|tojson }}, datasets:[
      line(C.navy, {{ trend.bd.suppliers|tojson }}), line(C.cyan, {{ trend.cn.suppliers|tojson }}),
      line(C.navy, {{ trend.bd.factories|tojson }}, true), line(C.cyan, {{ trend.cn.factories|tojson }}, true) ] },
    options:opts(false), plugins:[labels(String, false)] });
  new Chart(document.getElementById('chartRegion'), { type:'bar', data:{ labels:{{ region_lines.labels|tojson }}, datasets:[
      { data:{{ region_lines.bd|tojson }}, backgroundColor:C.navy, labelColor:C.navy, borderRadius:5, maxBarThickness:26 },
      { data:{{ region_lines.cn|tojson }}, backgroundColor:C.cyan, labelColor:C.cyanText, borderRadius:5, maxBarThickness:26 } ] },
    options:opts(true), plugins:[labels(k, true)] });
});
</script>
</body>
</html>
